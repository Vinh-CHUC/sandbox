setup:
    conan profile detect --force

install:
    conan install . --output-folder=build --build=missing

build:
    cd build && . ./conanbuild.sh && cmake .. -DCMAKE_TOOLCHAIN_FILE=conan_toolchain.cmake -DCMAKE_BUILD_TYPE=Release
    cd build && . ./conanbuild.sh && cmake --build .

run:
    ./build/compressor

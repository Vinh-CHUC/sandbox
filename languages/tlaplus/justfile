install-java:
    apt install openjdk-25-jre

install-tlaplus:
    #!/usr/bin/env bash
    set -euo pipefail

    version="1.7.4"
    bin_dir="$HOME/.local/bin"
    tmp_dir="$(mktemp -d)"
    trap 'rm -rf "$tmp_dir"' EXIT

    url="https://github.com/tlaplus/tlaplus/releases/download/v${version}/tla2tools.jar"

    curl -fLsS "$url" -o "$tmp_dir/tla2tools.jar"

    echo "bee4a54f3ee3d4afc347c3240ec2d9e93b075104  $tmp_dir/tla2tools.jar" | sha1sum -c -

    mkdir -p "$bin_dir"
    rm -f "$bin_dir/tla2tools.jar"
    mv "$tmp_dir/tla2tools.jar" "$bin_dir/tla2tools.jar"

    # CLI wrapper
    cat > "$bin_dir/tlc" <<'EOF'
    #!/usr/bin/env sh
    exec java -cp "$HOME/.local/bin/tla2tools.jar" tlc2.TLC "$@"
    EOF
    chmod +x "$bin_dir/tlc"

    # sany
    cat > "$bin_dir/tla_sany" <<'EOF'
    #!/usr/bin/env sh
    exec java -cp "$HOME/.local/bin/tla2tools.jar" tla2sany.SANY "$@"
    EOF
    chmod +x "$bin_dir/tla_sany"

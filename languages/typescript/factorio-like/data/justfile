# Flow trace pipeline: generate traces of parquet tables for the viewer (../public/traces)

# Where the viewer fetches traces from: one directory per scenario, listed in index.json
out := "../public/traces"

default:
    @just --list

# Install the locked dependencies
sync:
    uv sync --locked

# Run the tests
test *args:
    uv run pytest {{args}}

# Strict type check
typecheck:
    uv run pyright

# Everything CI would run
check: typecheck test

# Generate every scenario's trace into `out` (one site, two sites, two sites and a road)
trace seed="1" hours="8":
    uv run python -m flowtrace.generate --out {{out}} --seed {{seed}} --hours {{hours}}

# Replay-check every scenario's trace: schemas, references, and every event in `seq` order
validate dir=out:
    for d in {{dir}}/*/; do uv run python -m flowtrace.validate "$d" || exit 1; done

# Full pipeline: check, generate, then validate what was generated
pipeline seed="1" hours="8": check (trace seed hours) validate

# Remove generated traces
clean:
    rm -rf {{out}}
